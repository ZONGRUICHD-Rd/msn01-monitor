# MSN01 / CH32x035 USB Mini Screen (VID:1A86 PID:FE0C)
# Install on Linux:
#   sudo cp 99-msn01-screen.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   (Optional) sudo usermod -aG dialout "$USER"

SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="fe0c", MODE="0666", SYMLINK+="msn01"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="fe0c", MODE="0666"
