<Window
    x:Class="MSN01Monitor.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MSN01 硬件监控上位机">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="44,*,Auto">
        <!-- Custom Extended WinUI 3 Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="20,0,148,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="10" Height="10" CornerRadius="5" Background="#00E5FF" />
                <TextBlock Text="MSN01 硬件监控上位机" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="WinUI 3 · CH32x035" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="12" Padding="10,3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#F59E0B" />
                    <TextBlock x:Name="StatusBadgeText" Text="初始化中..." FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Two-Column Content -->
        <Grid Grid.Row="1" Padding="20,8,20,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="536" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Live Screen Preview + Hero Telemetry Cards -->
            <StackPanel Grid.Column="0" Spacing="14">
                <!-- Live 3x Preview Bezel Card -->
                <Border CornerRadius="10" Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="实时屏幕预览 (3× 像素级)" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="PerfText" Text="160×80 · -- ms" HorizontalAlignment="Right"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <!-- Hardware Bezel -->
                        <Border CornerRadius="10" Padding="10" Background="#020617"
                                BorderBrush="#475569" BorderThickness="2" HorizontalAlignment="Center">
                            <Image x:Name="PreviewImage" Width="480" Height="240" Stretch="Fill" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3 Hero Telemetry Cards -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CPU Card -->
                    <Border Grid.Column="0" CornerRadius="10" Padding="14,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="4" Height="14" CornerRadius="2" Background="#00E5FF" />
                                <TextBlock Text="CPU" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" />
                            </StackPanel>
                            <TextBlock x:Name="CpuValText" Text="--%" FontSize="26" FontWeight="Bold" FontFamily="Consolas" />
                            <ProgressBar x:Name="CpuBar" Minimum="0" Maximum="100" Value="0" Foreground="#00E5FF" />
                            <TextBlock x:Name="CpuSubText" Text="--" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- GPU Card -->
                    <Border Grid.Column="1" CornerRadius="10" Padding="14,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="4" Height="14" CornerRadius="2" Background="#22F59B" />
                                <TextBlock Text="GPU" FontSize="13" FontWeight="Bold" Foreground="#22F59B" />
                            </StackPanel>
                            <TextBlock x:Name="GpuValText" Text="--%" FontSize="26" FontWeight="Bold" FontFamily="Consolas" />
                            <ProgressBar x:Name="GpuBar" Minimum="0" Maximum="100" Value="0" Foreground="#22F59B" />
                            <TextBlock x:Name="GpuSubText" Text="--" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- RAM Card -->
                    <Border Grid.Column="2" CornerRadius="10" Padding="14,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="4" Height="14" CornerRadius="2" Background="#FFB020" />
                                <TextBlock Text="RAM" FontSize="13" FontWeight="Bold" Foreground="#FFB020" />
                            </StackPanel>
                            <TextBlock x:Name="RamValText" Text="--%" FontSize="26" FontWeight="Bold" FontFamily="Consolas" />
                            <ProgressBar x:Name="RamBar" Minimum="0" Maximum="100" Value="0" Foreground="#FFB020" />
                            <TextBlock x:Name="RamSubText" Text="--" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Right Column: Controls -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <!-- Connection Card -->
                    <Border CornerRadius="10" Padding="16,14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="设备连接" FontSize="14" FontWeight="SemiBold" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PortCombo" Grid.Column="0" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnPortSelectionChanged" />
                                <Button Grid.Column="1" Content="刷新" Click="OnRefreshPortsClick" />
                            </Grid>

                            <Button x:Name="ConnectButton" Content="断开连接" HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}" Click="OnToggleConnectClick" />

                            <ToggleSwitch x:Name="AutoReconnectToggle" Header="断线后自动重连"
                                          OnContent="已开启" OffContent="已关闭" Toggled="OnSettingsToggled" />
                        </StackPanel>
                    </Border>

                    <!-- Display & Telemetry Settings Card -->
                    <Border CornerRadius="10" Padding="16,14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="显示与监控配置" FontSize="14" FontWeight="SemiBold" />

                            <ComboBox x:Name="GpuCombo" Header="监控显卡 (GPU)" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnGpuSelectionChanged" />

                            <ComboBox x:Name="ThemeCombo" Header="仪表盘主题" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnThemeSelectionChanged" />

                            <Grid>
                                <TextBlock Text="刷新频率" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock x:Name="FpsValueText" Text="2.0 Hz" HorizontalAlignment="Right"
                                           FontFamily="Consolas" FontWeight="SemiBold" Foreground="#00E5FF" />
                            </Grid>
                            <Slider x:Name="FpsSlider" Minimum="0.5" Maximum="10.0" StepFrequency="0.5" Value="2.0"
                                    ValueChanged="OnFpsChanged" />

                            <Grid>
                                <TextBlock Text="软件亮度" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock x:Name="BrightValueText" Text="100%" HorizontalAlignment="Right"
                                           FontFamily="Consolas" FontWeight="SemiBold" Foreground="#00E5FF" />
                            </Grid>
                            <Slider x:Name="BrightSlider" Minimum="10" Maximum="100" StepFrequency="5" Value="100"
                                    ValueChanged="OnBrightnessChanged" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch x:Name="RotateToggle" Grid.Column="0" Header="画面旋转 180°"
                                              OnContent="开启" OffContent="关闭" Toggled="OnSettingsToggled" />
                                <ToggleSwitch x:Name="TouchToggle" Grid.Column="1" Header="触摸键切主题"
                                              OnContent="开启" OffContent="关闭" Toggled="OnSettingsToggled" />
                            </Grid>

                            <TextBlock x:Name="TouchAdcText" Text="触摸传感器 ADC: --" FontFamily="Consolas"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Status Footer -->
        <Border Grid.Row="2" Padding="20,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="FooterText" Text="准备就绪" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</Window>
